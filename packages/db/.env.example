# Copy to .env in this package (or export in your shell) for Prisma CLI commands.
#
# Local Supabase stack (packages/db/supabase/config.toml): Postgres on port 54322,
# database/user/password all `postgres`. prisma.config.ts falls back to this exact URL,
# so .env is only needed when pointing at a different host.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres?schema=public"

# Hosted Postgres: set DATABASE_URL to your provider's pooled URL for the app runtime and use
# the direct URL when running `prisma db pull` / migrations. No Supabase-specific keys:
# AIRA does not use Supabase Auth, so never add SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY
# to the apps (SECURITY.md §4).
