{
  "name": "@aira/db",
  "version": "0.0.0",
  "private": true,
  "description": "AIRA PostgreSQL schema - Supabase CLI (local Postgres + SQL migrations) with Prisma as an optional typed client. Not wired into apps yet.",
  "scripts": {
    "db:start": "supabase start --workdir .",
    "db:stop": "supabase stop --workdir .",
    "db:status": "supabase status --workdir .",
    "db:reset": "supabase db reset --workdir .",
    "db:migration:new": "supabase migration new --workdir .",
    "db:pull": "prisma db pull",
    "generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:prune": "node scripts/prune.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "7.10.1"
  },
  "devDependencies": {
    "@aira/typescript-config": "workspace:*",
    "@types/pg": "8.23.1",
    "pg": "8.23.1",
    "prisma": "7.10.1",
    "supabase": "2.121.0",
    "typescript": "5.9.3"
  }
}
